# Copy to deploy/icloud-mail.env (git-ignored) and fill in. Use an Apple
# app-specific password (appleid.apple.com → Sign-In and Security).
APPLE_MAIL_MCP_IMAP_HOST=imap.mail.me.com
APPLE_MAIL_MCP_IMAP_PORT=993
APPLE_MAIL_MCP_IMAP_USER=you@icloud.com
APPLE_MAIL_MCP_IMAP_PASSWORD=
APPLE_MAIL_MCP_SMTP_HOST=smtp.mail.me.com
APPLE_MAIL_MCP_SMTP_PORT=587
APPLE_MAIL_MCP_SMTP_SECURE=false
APPLE_MAIL_MCP_SMTP_USER=you@icloud.com
APPLE_MAIL_MCP_SMTP_PASSWORD=
APPLE_MAIL_MCP_SMTP_FROM=you@icloud.com
# Every address you may send as, comma-separated (custom-domain aliases too).
APPLE_MAIL_MCP_SMTP_ALLOWED_FROM=you@icloud.com

# The public HTTPS origin of this server, without a path.
ICLOUD_MAIL_PUBLIC_URL=https://mail.example.com
# At least 16 characters. Required to approve each Claude connection.
ICLOUD_MAIL_OWNER_PASSWORD=
