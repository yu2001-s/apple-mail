{
  "name": "icloud-mail-mcp",
  "version": "1.4.1",
  "packageManager": "pnpm@11.9.0",
  "description": "Direct iCloud IMAP/SMTP MCP connector for Claude and Codex, local or remote, with threaded replies and saved signatures",
  "type": "module",
  "main": "plugins/icloud-mail/server/server.cjs",
  "bin": {
    "icloud-mail-mcp": "plugins/icloud-mail/server/server.cjs"
  },
  "files": [
    "plugins/icloud-mail",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');const ua=process.env.npm_config_user_agent||'';if(fs.existsSync('.git')&&!ua.startsWith('pnpm')){console.error('\\nThis repo uses pnpm. npm/yarn resolve dependencies off-lockfile and the committed bundle will mismatch CI.\\n\\n  corepack enable && pnpm install --frozen-lockfile\\n');process.exit(1)}\"",
    "build": "tsc --noEmit && node scripts/package-icloud-plugin.mjs",
    "build:plugin": "pnpm build",
    "start": "node plugins/icloud-mail/server/server.cjs",
    "start:http": "node plugins/icloud-mail/server/server.cjs --http",
    "deploy:worker": "node scripts/setup-worker.mjs",
    "test:worker": "node --test test/worker-oauth.test.mjs",
    "dev": "tsc --watch --noEmit",
    "test": "vitest run && node --test test/plugin-boot.test.mjs test/http-oauth.test.mjs",
    "test:imap": "vitest run --config vitest.imap.config.ts",
    "test:all": "pnpm test && pnpm test:imap",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node --test test/plugin-boot.test.mjs test/http-oauth.test.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/sync-plugin-version.mjs && git add plugins/icloud-mail wrangler.jsonc",
    "prepublishOnly": "pnpm run lint && pnpm test && pnpm run build",
    "prepare": "husky; pnpm run build"
  },
  "keywords": [
    "icloud",
    "email",
    "imap",
    "smtp",
    "mcp",
    "claude",
    "codex",
    "macos"
  ],
  "author": "Poieti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yu2001-s/apple-mail.git"
  },
  "homepage": "https://github.com/yu2001-s/apple-mail#readme",
  "bugs": {
    "url": "https://github.com/yu2001-s/apple-mail/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "imapflow": "^1.7.8",
    "nodemailer": "^9.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  },
  "volta": {
    "node": "24.17.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "postcss": "^8.5.15"
  }
}
